# ─── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. (Optional for this slice.)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Google Gemini ─────────────────────────────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Bulk/chat default; marking can escalate. Keep it cheap by default.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MARKING_MODEL=gemini-2.5-pro
