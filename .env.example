# ══════════════════════════════════════════════════════════════════════════
#  Atlas — environment template
#  --------------------------------------------------------------------------
#  1. Copy this file:            cp .env.example .env.local
#  2. Fill in the values below (leave the two GEMINI_MODEL lines as-is).
#  3. Restart the dev server:    npm run dev
#
#  .env.local is gitignored — your real secrets are never committed.
#  Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ══════════════════════════════════════════════════════════════════════════

# ─── Supabase ──────────────────────────────────────────────────────────────
# Supabase dashboard → your project → Settings → API

# "Project URL"  (e.g. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# "Project API keys" → anon / public key  (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "Project API keys" → service_role key  (SERVER ONLY — never expose).
# Optional for this slice; leave blank if unused.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Google Gemini ─────────────────────────────────────────────────────────
# Create a key at https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Model routing (defaults are sensible — only change if you know why).
#   flash = cheap, used for chat + bulk work
#   pro   = higher quality, used for examiner-style marking
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MARKING_MODEL=gemini-2.5-pro
